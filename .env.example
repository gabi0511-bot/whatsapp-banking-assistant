# PostgreSQL connection string
DATABASE_URL=postgresql://invoice_xray:invoice_xray_secret@localhost:5432/invoice_xray

# Google Gemini API key (used for PDF extraction + AI Twin with automatic multi-model Flash rotation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail OAuth2 credentials (scopes: gmail.readonly + gmail.compose)
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_from_npm_run_gmail_auth

# Gmail inbox search query for Romanian utility & telecom invoices
GMAIL_SEARCH_QUERY=has:attachment (filename:pdf OR filename:xml) (factura OR factură OR invoice OR hidroelectrica OR eon OR engie OR ppc OR electrica OR digi OR orange OR vodafone) newer_than:14d

# Full name used to sign generated Romanian dispute email drafts
USER_FULL_NAME=Ion Popescu

# Target WhatsApp JID to receive Invoice X-Ray alerts, tracked QR codes & AI Twin replies (format: 407XXXXXXXX@s.whatsapp.net)
OWNER_WHATSAPP_JID=40712345678@s.whatsapp.net

# Cron schedules (timezone: Europe/Bucharest)
CRON_GMAIL_POLL=*/15 * * * *
CRON_REMINDER_DISPATCH=*/15 * * * *
CRON_PAYMENT_REMINDERS=*/15 * * * *
CRON_SUBSCRIPTION_GMAIL_POLL=*/2 * * * *
CRON_FREE_TRIAL_ALERTS=*/2 * * * *
CRON_MONTHLY_REVIEW=0 20 28-31 * *

# Subscription Zombie Radar & Gmail Free-Trial Watcher
GMAIL_FREE_TRIAL_QUERY=("free trial" OR "perioada de proba" OR "perioadă de probă" OR "reinnoire automata" OR "reînnoire automată" OR "auto-renew" OR "trial ends" OR "trial period" OR "nu vei fi taxat" OR "vei fi taxat" OR "you will be charged" OR "zile gratuit" OR "days free" OR "abonament anulat" OR "has been cancelled") -from:notifications@github.com newer_than:14d
GMAIL_SUBSCRIPTION_RECEIPT_QUERY=(("receipt" OR "chitanta" OR "chitanță" OR "billing" OR "plata recurenta" OR "reînnoire" OR "reinnoire") ("netflix" OR "spotify" OR "icloud" OR "google one" OR "youtube premium" OR "disney" OR "adobe" OR "openai" OR "chatgpt" OR "claude" OR "canva" OR "world class" OR "hbo" OR "skyshowtime" OR "voyo" OR "microsoft 365" OR "dropbox" OR "notion")) -from:notifications@github.com newer_than:30d
ZOMBIE_MICRO_THRESHOLD_RON=100
ZOMBIE_MIN_UNCONFIRMED_CHARGES=3

# Tracked Payment QR & Handoff HTTP Server
# Set to your ngrok / Cloudflare Tunnel / VPS HTTPS URL when scanning QR codes from a mobile phone
PUBLIC_BASE_URL=http://localhost:3080
TRACKING_SERVER_PORT=3080
AUTO_SEND_PAYMENT_QR=true
QR_UNACCESSED_REMINDER_HOURS=24
QR_ABANDONED_REMINDER_MINUTES=120

# Optional Revolut tag (without @) for one-tap payment handoff button on /pay/:token
OWNER_REVOLUT_TAG=

# Optional: Baileys session directory & log level
BAILEYS_AUTH_DIR=.baileys_auth
LOG_LEVEL=info
